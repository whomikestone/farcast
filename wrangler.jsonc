{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farcast",
  "main": "src/index.ts",
  // Lets the Worker read CHANGELOG.md as text, so the What's new page and the repo share one file.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "farcast",
      "database_id": "520eb048-85f4-4d2b-be92-5829a5b685fd",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in settings. See "Sign-in" in README.md. Leave a value empty to turn that method off.
  "vars": {
    "AUTH_PASSWORD": "on",          // "off" removes name + password accounts
    "GOOGLE_CLIENT_ID": "",         // also run: npx wrangler secret put GOOGLE_CLIENT_SECRET
    "ALLOWED_EMAILS": "",           // optional: comma-separated Google emails allowed in
    "ACCESS_TEAM_DOMAIN": "",       // e.g. yourteam.cloudflareaccess.com
    "ACCESS_AUD": ""                // the Access application's "Application Audience (AUD) Tag"
  },
  "observability": { "enabled": true }
}
